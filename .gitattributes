# Normalize line endings to LF in the repo, check out as-is on Windows.
# This avoids CRLF/LF churn when editing the same file from different tools.
* text=auto eol=lf

# Explicit text files
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.tex text eol=lf
*.bib text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.sh text eol=lf

# Binary files (never normalize)
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.svg binary
*.pkl binary
*.npz binary
*.npy binary
*.bin binary
*.safetensors binary
